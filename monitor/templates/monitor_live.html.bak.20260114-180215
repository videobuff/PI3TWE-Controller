<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>PI3TWE Live Monitor</title>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --bg: #0f1115;
      --panel: #171a21;
      --panel-border: #2a2f3a;
      --text: #e6e6e6;
      --muted: #a9b0bb;
      --accent: #4da3ff;
    }
    html, body { height: 100%; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    .wrap { max-width: 1100px; margin: 0 auto; padding: 18px; }
    .top {
      display: flex; gap: 12px; align-items: center; justify-content: space-between;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }
    .title { font-size: 18px; font-weight: 700; }
    .muted { color: var(--muted); font-size: 13px; }
    .pill {
      display: inline-block; padding: 6px 10px; border-radius: 999px;
      background: #12151b; border: 1px solid var(--panel-border);
      font-size: 12px; color: var(--muted);
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    @media (min-width: 900px) {
      .grid { grid-template-columns: 1fr 1fr; }
    }
    .card {
      background: var(--panel);
      border: 1px solid var(--panel-border);
      border-radius: 14px;
      padding: 14px;
      min-height: 300px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .card h2 { margin: 0; font-size: 14px; font-weight: 700; }
    .now { font-size: 13px; color: var(--muted); }
    .chartBox { position: relative; height: 240px; }
    .row { display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
    select, button, a.btnlink {
      background: #12151b;
      border: 1px solid var(--panel-border);
      color: var(--text);
      border-radius: 10px;
      padding: 8px 10px;
      font-size: 13px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      line-height: 1;
    }
    button { cursor:pointer; }
    a.btnlink:hover, button:hover { filter: brightness(1.08); }
    .btnlink.accent {
      background: var(--accent);
      color: #000;
      border-color: transparent;
      font-weight: 700;
    }
  </style>
</head>

<body>
  <div class="wrap">
    <div class="top">
      <div>
        <div class="title">PI3TWE Live Monitor</div>
        <div class="muted">INT (BMP280) live • EXT live (DHT zodra beschikbaar)</div>
      </div>
      <div class="row">
        <a class="btnlink accent" href="/monitor/" target="_self" rel="noopener">Historisch</a>

        <span id="statusPill" class="pill">idle</span>
        <label class="muted">Refresh</label>
        <select id="refresh">
          <option value="1">1s</option>
          <option value="2" selected>2s</option>
          <option value="5">5s</option>
          <option value="10">10s</option>
        </select>
        <button id="btnNow">Nu verversen</button>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <h2>INT temperatuur</h2>
        <div class="now">Nu: <span id="nowInt">—</span></div>
        <div class="chartBox"><canvas id="intChart"></canvas></div>
      </div>

      <div class="card">
        <h2>EXT temperatuur / humidity</h2>
        <div class="now">Nu: <span id="nowExt">—</span></div>
        <div class="chartBox"><canvas id="extChart"></canvas></div>
      </div>
    </div>
  </div>

<script>
  // Chart defaults (donker)
  Chart.defaults.color = "#e6e6e6";
  Chart.defaults.borderColor = "#2a2f3a";

  let intChart = null;
  let extChart = null;

  let refreshTimer = null;
  let refreshIntervalSec = 2;
  let tabIsVisible = true;

  // We houden 10 minuten live buffer in de browser (600 punten bij 1s).
  const MAX_SECONDS = 10 * 60;

  // Rolling average window: 60 seconden
  const AVG_WINDOW_SEC = 60;

  // Buffers (epoch ms + values)
  const buf = {
    int: [], // {t: ms, temp: number|null}
    ext: []  // {t: ms, temp: number|null, hum: number|null}
  };

  function setStatus(text) {
    const el = document.getElementById("statusPill");
    if (el) el.textContent = text;
  }

  function fmt1(v) {
    return (v === null || v === undefined) ? null : Number(v.toFixed(1));
  }

  function setNow(id, temp, hum) {
    const el = document.getElementById(id);
    if (!el) return;
    const t = (temp === null || temp === undefined) ? "—" : `${temp.toFixed(1)} °C`;
    if (hum === null || hum === undefined) el.textContent = t;
    else el.textContent = `${t} • ${hum.toFixed(1)} %`;
  }

  function pruneBuffer(arr) {
    const cutoff = Date.now() - (MAX_SECONDS * 1000);
    while (arr.length && arr[0].t < cutoff) arr.shift();
  }

  function labelsFrom(arr) {
    return arr.map(p => new Date(p.t).toLocaleTimeString());
  }

  function rollingAverage(arr, valueSelector) {
    const out = new Array(arr.length).fill(null);

    let j = 0;
    let sum = 0;
    let count = 0;

    for (let i = 0; i < arr.length; i++) {
      const ti = arr[i].t;
      const vi = valueSelector(arr[i]);

      if (vi !== null && vi !== undefined) { sum += vi; count += 1; }

      const windowStart = ti - (AVG_WINDOW_SEC * 1000);
      while (j <= i && arr[j].t < windowStart) {
        const vj = valueSelector(arr[j]);
        if (vj !== null && vj !== undefined) { sum -= vj; count -= 1; }
        j++;
      }

      out[i] = (count > 0) ? Number((sum / count).toFixed(1)) : null;
    }

    return out;
  }

function clamp(v, lo, hi) {
  return Math.min(hi, Math.max(lo, v));
}

function avgOfLastSeconds(arr, valueSelector, seconds) {
  const cutoff = Date.now() - seconds * 1000;
  let sum = 0;
  let count = 0;
  for (let i = arr.length - 1; i >= 0; i--) {
    const p = arr[i];
    if (!p || p.t < cutoff) break;
    const v = valueSelector(p);
    if (v !== null && v !== undefined) {
      sum += v;
      count += 1;
    }
  }
  return count ? (sum / count) : null;
}

function setTempScale(chart, minVal, maxVal, axisId) {
  // axisId: "y" voor single axis, of bv "yTemp"
  const ax = chart?.options?.scales?.[axisId];
  if (!ax) return;
  ax.min = minVal;
  ax.max = maxVal;
}

  function buildIntChart() {
    const ctx = document.getElementById("intChart");
    return new Chart(ctx, {
      type: "line",
      data: {
        labels: [],
datasets: [
  {
    label: "INT temp (°C)",
    data: [],
    tension: 0.25,
    borderWidth: 3,
    pointRadius: 0,
    borderColor: "#4da3ff",
    backgroundColor: "rgba(77,163,255,0.18)",
    fill: true,
  },
  {
    label: "Gemiddelde (60s)",
    data: [],
    borderWidth: 2,
    borderDash: [6, 6],
    pointRadius: 0,
    borderColor: "#ffb020",
    backgroundColor: "rgba(0,0,0,0)",
    fill: false,
  }
]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (ctx) => {
                const v = ctx.parsed.y;
                return (v === null || v === undefined) ? "—" : Number(v).toFixed(1);
              }
            }
          }
        },
        scales: {
          x: { ticks: { maxTicksLimit: 8 } },
          y: { ticks: { callback: (v) => Number(v).toFixed(1) } }
        }
      }
    });
  }

  function buildExtChart() {
    const ctx = document.getElementById("extChart");
    return new Chart(ctx, {
      type: "line",
      data: {
        labels: [],
datasets: [
  { // temp
    label: "EXT temp (°C)",
    data: [],
    tension: 0.25,
    borderWidth: 3,
    pointRadius: 0,
    borderColor: "#4da3ff",
    backgroundColor: "rgba(77,163,255,0.14)",
    fill: true,
    yAxisID: "yTemp"
  },
  { // temp avg
    label: "Temp avg (60s)",
    data: [],
    borderWidth: 2,
    borderDash: [6, 6],
    pointRadius: 0,
    borderColor: "#ffb020",
    backgroundColor: "rgba(0,0,0,0)",
    fill: false,
    yAxisID: "yTemp"
  },
  { // hum
    label: "EXT hum (%)",
    data: [],
    tension: 0.25,
    borderWidth: 3,
    pointRadius: 0,
    borderColor: "#45d483",
    backgroundColor: "rgba(69,212,131,0.12)",
    fill: true,
    yAxisID: "yHum"
  },
  { // hum avg
    label: "Hum avg (60s)",
    data: [],
    borderWidth: 2,
    borderDash: [6, 6],
    pointRadius: 0,
    borderColor: "#ffd166",
    backgroundColor: "rgba(0,0,0,0)",
    fill: false,
    yAxisID: "yHum"
  },
]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        plugins: {
          legend: { display: true, labels: { boxWidth: 12, boxHeight: 12 } },
          tooltip: {
            callbacks: {
              label: (ctx) => {
                const v = ctx.parsed.y;
                return (v === null || v === undefined) ? "—" : Number(v).toFixed(1);
              }
            }
          }
        },
        scales: {
          x: { ticks: { maxTicksLimit: 8 } },
          yTemp: {
            type: "linear",
            position: "left",
            ticks: { callback: (v) => Number(v).toFixed(1) },
            title: { display: true, text: "°C" }
          },
          yHum: {
            type: "linear",
            position: "right",
            beginAtZero: true,
            suggestedMax: 100,
            ticks: { callback: (v) => Number(v).toFixed(1) },
            grid: { drawOnChartArea: false },
            title: { display: true, text: "%" }
          }
        }
      }
    });
  }

  async function fetchLive() {
    const r = await fetch("/monitor/api/live", { cache: "no-store" });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    return await r.json();
  }

  function updateCharts() {
    const intLabels = labelsFrom(buf.int);
    const intTemp = buf.int.map(p => p.temp);
    const intAvg  = rollingAverage(buf.int, p => p.temp);

    intChart.data.labels = intLabels;
    intChart.data.datasets[0].data = intTemp;
    intChart.data.datasets[1].data = intAvg;
    intChart.update("none");

    const extLabels = labelsFrom(buf.ext);
    const extTemp = buf.ext.map(p => p.temp);
    const extHum  = buf.ext.map(p => p.hum);

    const extTempAvg = rollingAverage(buf.ext, p => p.temp);
    const extHumAvg  = rollingAverage(buf.ext, p => p.hum);

    extChart.data.labels = extLabels;
    extChart.data.datasets[0].data = extTemp;
    extChart.data.datasets[1].data = extTempAvg;
    extChart.data.datasets[2].data = extHum;
    extChart.data.datasets[3].data = extHumAvg;
    extChart.update("none");
  }

  async function tick() {
  try {
    // Alleen "laden…" tonen als de call merkbaar lang duurt, voorkomt knipperen
    const loadTimer = setTimeout(() => setStatus("laden…"), 350);

    const data = await fetchLive();
    clearTimeout(loadTimer);

    const now = Date.now();

    const it = data?.int ?? {};
    const ex = data?.ext ?? {};

    const itTemp = (it.temp === null || it.temp === undefined) ? null : Number(it.temp);
    const exTemp = (ex.temp === null || ex.temp === undefined) ? null : Number(ex.temp);
    const exHum  = (ex.hum  === null || ex.hum  === undefined) ? null : Number(ex.hum);

    // buffers
    buf.int.push({ t: now, temp: fmt1(itTemp) });
    buf.ext.push({ t: now, temp: fmt1(exTemp), hum: fmt1(exHum) });

    pruneBuffer(buf.int);
    pruneBuffer(buf.ext);

    // now labels
    setNow("nowInt", itTemp, null);
    setNow("nowExt", exTemp, exHum);

    updateCharts();

    // Zet status op ok (zonder “laden” als fetch snel was)
    setStatus("ok");
  } catch (e) {
    setStatus(`fout: ${e?.message ?? e}`);
  }
}

  function stopRefreshTimer() {
    if (refreshTimer) { clearInterval(refreshTimer); refreshTimer = null; }
  }

  function startRefreshTimer() {
    if (refreshTimer || refreshIntervalSec <= 0 || !tabIsVisible) return;
    refreshTimer = setInterval(tick, refreshIntervalSec * 1000);
  }

  function applyAutoRefresh() {
    const sel = document.getElementById("refresh");
    const v = parseInt(sel?.value, 10);
    refreshIntervalSec = Number.isFinite(v) ? v : 2;

    stopRefreshTimer();
    startRefreshTimer();
  }

  document.addEventListener("visibilitychange", () => {
    tabIsVisible = !document.hidden;
    if (!tabIsVisible) {
      stopRefreshTimer();
    } else {
      tick();
      startRefreshTimer();
    }
  });

  document.addEventListener("DOMContentLoaded", () => {
    intChart = buildIntChart();
    extChart = buildExtChart();

    tick();
    applyAutoRefresh();

    document.getElementById("refresh").addEventListener("change", applyAutoRefresh);
    document.getElementById("btnNow").addEventListener("click", () => tick());
  });
</script>
</body>
</html>